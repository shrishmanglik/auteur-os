{
  "name": "auteur-studio-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "npm run build && node scripts/package-offline.mjs",
    "offline": "node scripts/serve-offline.mjs",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "start:web": "npm --prefix web run start",
    "check:web": "npm --prefix web run check",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "next": "^16.2.10",
    "tsx": "4.23.0",
    "typescript": "^5.9.3",
    "vite": "6.4.3"
  }
}
